{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // サプライチェーン攻撃対策。公開から3日経つまで PR を作らない
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  // develop にブランチ保護が無いため、GitHub ネイティブの auto-merge だと CI 失敗でもマージされうる
  platformAutomerge: false,
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      // PR の CI(go build/test/lint)で検証される Go モジュールだけ自動マージ。Go 本体の版(golang-version)は含めない
      matchManagers: ['gomod'],
      matchDatasources: ['go'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
  ],
  vulnerabilityAlerts: {
    // 既定は null(待たない)。修正版を装った悪性リリースも同じく3日待つ
    minimumReleaseAge: '3 days',
  },
}
